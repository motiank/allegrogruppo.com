{
  "manifest_version": 3,
  "name": "Joya Update — נט המשפט + בנק הפועלים + ביקום",
  "version": "1.1.0",
  "description": "Brings new court papers from נט המשפט into the Joya HQ legal archive, the new bank moves and cheque pictures from the Bank Hapoalim business site into the admin, and the Beecomm sales data (fetched from this browser with the server's login). Works only when started from the Joya HQ System page.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://securesso.court.gov.il/*",
    "https://*.s3.il-central-1.amazonaws.com/*",
    "https://biz2.bankhapoalim.co.il/*",
    "https://www.bankhapoalim.biz/*",
    "https://login.bankhapoalim.co.il/*",
    "https://20cs5hma71.execute-api.eu-west-1.amazonaws.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://hq.allegrogruppo.com/*", "http://localhost:4300/*", "http://127.0.0.1:4300/*", "http://localhost:4301/*", "http://127.0.0.1:4301/*"], "js": ["hq.js"], "run_at": "document_start" },
    { "matches": ["https://securesso.court.gov.il/Ngcs.Web.Secured/*"], "js": ["court.js"], "run_at": "document_idle" },
    { "matches": ["https://securesso.court.gov.il/Ngcs.Web.Secured/*"], "js": ["court_main.js"], "run_at": "document_idle", "world": "MAIN" },
    { "matches": ["https://biz2.bankhapoalim.co.il/*"], "js": ["bank.js"], "run_at": "document_idle" }
  ]
}
