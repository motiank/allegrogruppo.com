# Claude model (a CLI alias or a full model id). Uses the logged-in `claude` CLI, never an API key.
MODEL=sonnet
# Full path to the CLI if cron cannot find it (cron has a short PATH).
CLAUDE_BIN=claude

# Limits for one run.
MAX_INVOICES_PER_RUN=20
MAX_EMAILS_PER_RUN=20

# Only emails after this date (YYYY/MM/DD). Empty = the whole mailbox.
GMAIL_AFTER=2026/01/01
# Replace the Gmail search if you need to. Empty = the built-in search.
GMAIL_QUERY=

# The main folder in Google Drive. The script creates it.
DRIVE_ROOT_FOLDER=Invoices
