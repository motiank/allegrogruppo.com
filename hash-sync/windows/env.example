# Settings of the Hashavshevet sync on this computer. Keep this file private: it holds passwords.

# Source: the SQL Server of Hashavshevet on this computer.
HASH_MSSQL_HOST=localhost
# Instance name. Hashavshevet usually installs the instance WIZSOFT (the server shows as COMPUTERNAME\WIZSOFT).
# The Windows service "SQL Server Browser" must run. Leave it empty to use the port instead.
HASH_MSSQL_INSTANCE=WIZSOFT
HASH_MSSQL_PORT=1433
# A SQL Server login that can read the company database (sa, or a login with db_datareader).
# Use the same instance (or port) and password that work from the other computer: each instance has its own sa password.
# A password with # or spaces or quotes must be written in single quotes, for example 'pa#ss'
HASH_MSSQL_USER=sa
HASH_MSSQL_PASSWORD=
# The name of the company database in SQL Server. check.cmd prints the list of databases on the server.
HASH_MSSQL_DATABASE=
# Set to 1 only when check.cmd says the SQL Server is old (no TLS 1.2).
HASH_MSSQL_OLD_TLS=

# Target: the production MySQL server (allegro_finance).
# Copy TARGET_DB_HOST, TARGET_DB_USER and TARGET_DB_PASSWORD from .env.production on the development machine.
TARGET_DB_HOST=
TARGET_DB_PORT=25060
TARGET_DB_USER=
# Also in single quotes when it has # or quotes.
TARGET_DB_PASSWORD=
TARGET_DB_NAME=allegro_finance
# The CA certificate of the MySQL server. ca.crt is in this folder.
TARGET_DB_SSL_CA=ca.crt
