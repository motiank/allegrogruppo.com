# Source: the SQL Server that holds the restored Hashavshevet database
HASH_MSSQL_HOST=localhost
HASH_MSSQL_PORT=1433
# For a named instance, such as WIZSOFT. The port is then not used, and SQL Server Browser must run.
HASH_MSSQL_INSTANCE=
HASH_MSSQL_USER=sa
HASH_MSSQL_PASSWORD=
HASH_MSSQL_DATABASE=PastaLina

# Target: a MySQL server. Any host other than localhost also needs the --production flag.
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=3306
TARGET_DB_USER=
TARGET_DB_PASSWORD=
TARGET_DB_NAME=allegro_finance_dev
TARGET_DB_SSL_CA=
