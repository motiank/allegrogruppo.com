{
  "name": "joya-hq",
  "version": "0.1.0",
  "description": "Joya HQ (hq.allegrogruppo.com): the AI headquarters of the Allegro group restaurants (API + phone app + AI runner). Logins are the Allegro admin users; data comes from the admin Local Data API.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch src --watch lib server.js",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node test/test_joya_lib.mjs",
    "smoke": "node scripts/joya-smoke.mjs",
    "runner": "node runner/index.js",
    "test:runner": "node runner/test/runner.test.js",
    "eval": "node runner/scripts/eval.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.10.0",
    "pino": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-jss": "^10.10.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "nodemon": "^3.0.0",
    "vite": "^6.4.3"
  }
}
