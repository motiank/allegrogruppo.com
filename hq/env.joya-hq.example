# Joya HQ env — on the server: hq/.env (gitignored). Never commit real values.
# The DB settings come from the Allegro repo-root .env (the `allegro` DB, like the admin).
# Locally: copy this to hq/.env.local. Development uses the production DB from the root .env too.

# Only to override the root .env, e.g. for the smoke test against a local MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_SSL_CA=
# JOYA_DB_NAME=joya          (the joya_* tables; default DB_NAME)

# Signs the login cookie. Any long random string: openssl rand -hex 32
JOYA_SESSION_SECRET=
# Machine key of the AI runner (hq/runner sends it as X-Joya-Key). Both read this file.
JOYA_API_KEY=

# Logins are the Allegro admin users (repo-root users.json); override only in tests.
# ALLEGRO_USERS_FILE=

# The Allegro admin Local Data API — the only source of sales, employees, clock times and payroll.
# It answers on its own machine only (loopback), so Joya runs on the same server as the admin.
ALLEGRO_API_URL=http://localhost:3021/local-api/v1
# How long an answer is kept in memory (ms). Nothing is ever written to disk or the DB.
ALLEGRO_CACHE_MS=300000

JOYA_HQ_PORT=4300
JOYA_HQ_HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# The AI runner (runner/index.js) also reads: JOYA_HQ_URL (http://localhost:4300/api), JOYA_MODEL (sonnet),
# JOYA_POLL_MS, JOYA_CONCURRENCY, JOYA_STATE_DIR.
